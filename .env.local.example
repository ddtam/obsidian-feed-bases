# Copy to .env.local and point at the vault you want to test in.
# `npm run dev` will install the plugin into
# <vault>/.obsidian/plugins/feed-bases-fork/ on every rebuild.
#
# If this is unset, `npm run dev` writes the artifacts to the repo root
# instead — a dev session that appears to change nothing in the vault is
# usually this.
OBSIDIAN_VAULT=/absolute/path/to/your/vault
